# Copie para `.env` (nesta pasta) e preencha. Nunca commite o `.env`.

# --- Endereços (sem https://). Os dois precisam estar no mesmo domínio-pai,
#     ex.: app.ignis.com.br e api.ignis.com.br, e apontar para o IP do servidor.
APP_HOST=app.exemplo.com.br
API_HOST=api.exemplo.com.br

# --- Segredos: gere cada um com `openssl rand -base64 36`
POSTGRES_PASSWORD=
MONGO_PASSWORD=
JWT_SECRET=

# --- IA (Groq). Sem a chave, o chat fica indisponível; o resto do app funciona.
GROQ_API_KEY=

# --- Opcionais (descomente para mudar o padrão)
# GROQ_MODEL=openai/gpt-oss-120b
# GROQ_SUMMARY_MODEL=openai/gpt-oss-20b
# AI_DAILY_TOKEN_LIMIT=200000
# OCR=off
# EMBEDDINGS=off

# --- Portas expostas pelo Caddy (só mude para testes locais)
# HTTP_PORT=80
# HTTPS_PORT=443
