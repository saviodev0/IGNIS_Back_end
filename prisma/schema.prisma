// Prisma schema do IGNIS

generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id          String @id @default(uuid())
  name        String
  age         Int
  email       String @unique
  phone       String
  password    String
  ignisPoints Int    @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  studyCycles  StudyCycle[]
  achievements UserAchievement[]
  goals        Goal[]
}

model StudyCycle {
  id Int @id @default(autoincrement())

  durationMinutes Int
  startedAt       DateTime
  completedAt     DateTime?

  completed Boolean @default(false)

  ignisEarned Int @default(0)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}

model Achievement {
  id          Int    @id @default(autoincrement())
  code        String @unique
  name        String
  description String
  icon        String
  type        String
  requirement Int

  createdAt DateTime @default(now())

  users UserAchievement[]
}

model UserAchievement {
  id            Int      @id @default(autoincrement())
  userId        String
  achievementId Int
  unlockedAt    DateTime @default(now())

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievement Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)

  @@unique([userId, achievementId])
}

model Goal {
  id Int @id @default(autoincrement())

  type String // DAILY, WEEKLY ou MONTHLY

  targetMinutes Int

  startDate DateTime
  endDate   DateTime

  completed Boolean @default(false)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}
